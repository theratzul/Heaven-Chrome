static uint8_t game_state;
static uint8_t current_level;
static uint16_t score;
static uint8_t lives;
static uint8_t frame_counter;

 
static void show_title_screen(void)
{
    video_cls( 0x07  |  0x00 );
    video_set_border(0);

     
    video_print_at( 3, 9, "C H R O N O S");
    video_print_at( 6, 6, "A Time-Bending Adventure");
    video_print_at(10, 7, "Controls:");
    video_print_at(12, 7, "Q/A   - Up/Down");
    video_print_at(13, 7, "O/P   - Left/Right");
    video_print_at(14, 7, "SPACE - Time Shift");
    video_print_at(15, 7, "M     - Pause");
    video_print_at(19, 5, "Press SPACE to begin...");
    video_print_at(22, 5, "(c) 2026 Chronos Project");

     
    while (!(input_read_keys() &  0x10 )) {
         z80_delay_ms_fastcall( 50 ) ;
    }
     
     z80_delay_ms_fastcall( 200 ) ;
}

 
static void show_game_over(void)
{
    video_cls( 0x02  |  0x00 );
    video_set_border(2);

    video_print_at( 8, 10, "GAME  OVER");
    video_print_at(12, 7, "Press SPACE to retry");

    sound_fx_hit();

    while (!(input_read_keys() &  0x10 )) {
         z80_delay_ms_fastcall( 50 ) ;
    }
     z80_delay_ms_fastcall( 200 ) ;
}

 
static void show_level_complete(void)
{
    video_cls( 0x04  |  0x00 );
    video_set_border(4);

    video_print_at( 8, 8, "LEVEL COMPLETE!");

    sound_fx_pickup();
     z80_delay_ms_fastcall( 2000 ) ;
}

 
static void game_init(void)
{
    score = 0;
    lives = 3;
    current_level = 0;
    frame_counter = 0;

    player_init();
    chrono_init();
}

 
static void game_update(void)
{
    uint8_t keys;

    frame_counter++;
    keys = input_read_keys();

     
    if (keys &  0x20 ) {
        game_state =  2 ;
        return;
    }

     
    chrono_update(keys);

     
    player_update(keys);

     
    if (level_check_collision(player_get_x(), player_get_y())) {
        player_on_hit();
        sound_fx_hit();
        if (player_get_lives() == 0) {
            game_state =  3 ;
            return;
        }
    }

     
    if (level_check_exit(player_get_x(), player_get_y())) {
        current_level++;
        if (current_level >=  3 ) {
            game_state =  3 ;  
        } else {
            game_state =  4 ;
        }
        return;
    }

     
    video_cls( 0x07  |  0x00 );
    level_draw(current_level);
    player_draw();
    hud_draw(score, lives, chrono_get_energy());
}

 
void main(void)
{
     
    isr_install();

     
    intrinsic_ei();

     
    for (;;) {
        switch (game_state) {

            case  0 :
                show_title_screen();
                game_init();
                game_state =  1 ;
                break;

            case  1 :
                intrinsic_halt();    
                game_update();
                break;

            case  2 :
                video_print_at(10, 11, "** PAUSED **");
                while (input_read_keys() &  0x20 ) {
                     z80_delay_ms_fastcall( 50 ) ;
                }
                 z80_delay_ms_fastcall( 200 ) ;
                game_state =  1 ;
                break;

            case  3 :
                show_game_over();
                game_state =  0 ;
                break;

            case  4 :
                show_level_complete();
                level_load(current_level);
                player_reset_position();
                game_state =  1 ;
                break;
        }
    }
}

