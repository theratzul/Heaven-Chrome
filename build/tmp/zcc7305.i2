struct sp1_Rect {

   uint8_t row;
   uint8_t col;
   uint8_t width;
   uint8_t height;

};

struct sp1_update;
struct sp1_ss;
struct sp1_cs;

struct sp1_update {                    

   uint8_t              nload;           
   uint8_t              colour;          
   uint16_t             tile;            
   struct sp1_cs       *slist;           
   struct sp1_update   *ulist;           
   uint8_t             *screen;          

};

struct sp1_ss {                        

   uint8_t              row;             
   uint8_t              col;             
   uint8_t              width;           
   uint8_t              height;          

   uint8_t              vrot;            
   uint8_t              hrot;            

   uint8_t             *frame;           

   uint8_t              res0;            
   uint8_t              e_hrot;          
   uint8_t              res1;            
   uint16_t             e_offset;        
   uint8_t              res2;            
   uint8_t              res3;            

   struct sp1_cs     *first;           

   uint8_t              xthresh;         
   uint8_t              ythresh;         
   uint8_t              nactive;         

};

struct sp1_cs {                        

   struct sp1_cs     *next_in_spr;     

   struct sp1_update *update;          

   uint8_t              plane;           
   uint8_t              type;            
   uint8_t              attr_mask;       
   uint8_t              attr;            

   void                *ss_draw;         

   uint8_t              res0;            
   uint8_t             *def;             
   uint8_t              res1;            
   uint8_t              res2;            
   uint8_t             *l_def;           
   uint8_t              res3;            
   void                *draw;            

   struct sp1_cs       *next_in_upd;     
   struct sp1_cs       *prev_in_upd;     

};

struct sp1_ap {                        

   uint8_t              attr_mask;       
   uint8_t              attr;            

};

struct sp1_tp {                        

   uint8_t              attr;            
   uint16_t             tile;            

};

struct sp1_pss {                       

   struct sp1_Rect     *bounds;          
   uint8_t              flags;           
   uint8_t              x;               
   uint8_t              y;               
   uint8_t              attr_mask;       
   uint8_t              attr;            
   struct sp1_update   *pos;             
   void                *visit;           
   
};

 
 
 

 







 
 








 

