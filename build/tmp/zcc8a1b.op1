;	---------------------------------
; Function level_get_tile
; ---------------------------------
_level_get_tile::
	push	ix
	ld	ix,#0
	add	ix,sp
	ld	a, 4 (ix)
	sub	a, #0x20
	jr	NC,l_level_get_tile_00101$
	ld	a, 5 (ix)
	sub	a, #0x18
	jr	C,l_level_get_tile_00102$
l_level_get_tile_00101$:
	ld	l, #0x01
	jr	l_level_get_tile_00104$
l_level_get_tile_00102$:
	ld	l, 5 (ix)
	ld	h, #0x00
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	ld	c, 4 (ix)
	ld	b, #0x00
	add	hl, bc
	ld	de, #_current_level_map
	add	hl, de
	ld	l, (hl)
l_level_get_tile_00104$:
	pop	ix
	ret
;	---------------------------------
; Function level_draw
; ---------------------------------
_level_draw::
	push	ix
	ld	ix,#0
	add	ix,sp
	ld	a, 4 (ix)
	push	af
	inc	sp
	call	_level_load
	inc	sp
	ld	c, #0x00
l_level_draw_00121$:
	ld	b, #0x00
l_level_draw_00110$:
	push	bc
	ld	a, c
	ld	c,b
	ld	b,a
	push	bc
	call	_level_get_tile
	pop	af
	ld	a, l
	pop	bc
	cp	a, #0x01
	jr	Z,l_level_draw_00101$
	cp	a, #0x02
	jr	Z,l_level_draw_00102$
	cp	a, #0x03
	jr	Z,l_level_draw_00103$
	cp	a, #0x04
	jr	Z,l_level_draw_00104$
	sub	a, #0x05
	jr	Z,l_level_draw_00105$
	jr	l_level_draw_00111$
l_level_draw_00101$:
	push	bc
	ld	hl, #_tile_wall_gfx
	push	hl
	ld	a, c
	ld	c,b
	ld	b,a
	push	bc
	call	_sprite_draw
	pop	af
	pop	af
	pop	bc
	jr	l_level_draw_00111$
l_level_draw_00102$:
	push	bc
	ld	hl, #_tile_platform_gfx
	push	hl
	ld	a, c
	ld	c,b
	ld	b,a
	push	bc
	call	_sprite_draw
	pop	af
	pop	af
	pop	bc
	jr	l_level_draw_00111$
l_level_draw_00103$:
	push	bc
	ld	hl, #_tile_hazard_gfx
	push	hl
	ld	a, c
	ld	c,b
	ld	b,a
	push	bc
	call	_sprite_draw
	pop	af
	pop	af
	pop	bc
	jr	l_level_draw_00111$
l_level_draw_00104$:
	push	bc
	ld	hl, #_tile_exit_gfx
	push	hl
	ld	a, c
	ld	c,b
	ld	b,a
	push	bc
	call	_sprite_draw
	pop	af
	pop	af
	pop	bc
	jr	l_level_draw_00111$
l_level_draw_00105$:
	push	bc
	ld	hl, #_tile_angel_gfx
	push	hl
	ld	a, c
	ld	c,b
	ld	b,a
	push	bc
	call	_sprite_draw
	pop	af
	pop	af
	pop	bc
l_level_draw_00111$:
	inc	b
	ld	a, b
	sub	a, #0x20
	jr	C,l_level_draw_00110$
	inc	c
	ld	a, c
	sub	a, #0x18
	jp	C, l_level_draw_00121$
	pop	ix
	ret
;	---------------------------------
; Function level_check_collision
; ---------------------------------
_level_check_collision::
	push	ix
	ld	ix,#0
	add	ix,sp
	ld	h,5 (ix)
	ld	l,4 (ix)
	push	hl
	call	_level_get_tile
	pop	af
	ld	a, l
	cp	a, #0x01
	jr	Z,l_level_check_collision_00106$
	sub	a, #0x03
	jr	NZ,l_level_check_collision_00103$
l_level_check_collision_00106$:
	ld	l, #0x01
	jr	l_level_check_collision_00104$
l_level_check_collision_00103$:
	ld	l, #0x00
l_level_check_collision_00104$:
	pop	ix
	ret
;	---------------------------------
; Function level_check_exit
; ---------------------------------
_level_check_exit::
	push	ix
	ld	ix,#0
	add	ix,sp
	ld	h,5 (ix)
	ld	l,4 (ix)
	push	hl
	call	_level_get_tile
	pop	af
	ld	a, l
	sub	a, #0x04
	jr	NZ,l_level_check_exit_00103$
	ld	l, #0x01
	jr	l_level_check_exit_00104$
l_level_check_exit_00103$:
	ld	l, #0x00
l_level_check_exit_00104$:
	pop	ix
	ret
;	---------------------------------
; Function level_check_angel
; ---------------------------------
_level_check_angel::
	push	ix
	ld	ix,#0
	add	ix,sp
	ld	h,5 (ix)
	ld	l,4 (ix)
	push	hl
	call	_level_get_tile
	pop	af
	ld	a, l
	sub	a, #0x05
	jr	NZ,l_level_check_angel_00103$
	ld	l, #0x01
	jr	l_level_check_angel_00104$
