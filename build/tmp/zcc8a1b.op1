	ld	l,a
	or	a, a
	jr	Z,l_level_load_00111$
	ld	a, d
	sub	a, #0x03
	jr	NC,l_level_load_00111$
	ld	-1 (ix), l
	ld	l, c
	ld	h, b
	inc	hl
	ld	a, (hl)
	ld	-2 (ix), a
l_level_load_00104$:
	ld	a, -1 (ix)
	or	a, a
	jr	Z,l_level_load_00120$
	ld	a, d
	sub	a, #0x03
	jr	NC,l_level_load_00120$
	ld	hl, #_current_level_map
	add	hl, de
	inc	de
	ld	a, -2 (ix)
	ld	(hl), a
	dec	-1 (ix)
	jr	l_level_load_00104$
l_level_load_00120$:
	inc	bc
	inc	bc
	jr	l_level_load_00108$
l_level_load_00111$:
	ld	sp, ix
	pop	ix
	ret
