_level_load::
	push	ix
	ld	ix,#0
	add	ix,sp
	push	af
	ld	de, #0x0000
	ld	a, 4 (ix)
	sub	a, #0x14
	jr	NC,l_level_load_00111$
	ld	bc, #_levels+0
	ld	l, 4 (ix)
	ld	h, #0x00
	add	hl, hl
	add	hl, bc
	ld	c, (hl)
	inc	hl
	ld	b, (hl)
