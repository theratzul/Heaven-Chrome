; Function player_init
; ---------------------------------
_player_init:
	ld	hl,_start_x
	ld	(hl),0x02
	ld	hl,_start_y
	ld	(hl),0x14
	ld	hl,_px
	ld	(hl),0x02
	ld	hl,_py
	ld	(hl),0x14
	ld	hl,_lives
	ld	(hl),0x03
	xor	a,a
	ld	(_invincible),a
	ld	(_facing),a
	ret
	SECTION rodata_compiler
_player_sprite:
